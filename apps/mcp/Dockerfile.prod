# Production image for the MCP server. Build from the repository root:
#   docker build -f apps/mcp/Dockerfile.prod -t lukitas-mcp .

FROM node:22-alpine AS build
WORKDIR /repo
RUN corepack enable

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml .pnpmfile.cjs ./
COPY packages/core/package.json packages/core/
COPY packages/ai-assistant-tools/package.json packages/ai-assistant-tools/
COPY apps/mcp/package.json apps/mcp/
RUN pnpm install --frozen-lockfile --filter "@lukas/mcp..."

COPY tsconfig.base.json ./
COPY packages/core packages/core
COPY packages/ai-assistant-tools packages/ai-assistant-tools
COPY apps/mcp apps/mcp
# One bundle with every dependency inside: no node_modules in the final image.
RUN pnpm --filter @lukas/mcp build


FROM node:22-alpine AS runtime
ARG LUKITAS_VERSION=
ENV NODE_ENV=production LUKITAS_VERSION=$LUKITAS_VERSION
WORKDIR /app
COPY --from=build /repo/apps/mcp/dist ./dist
USER node
EXPOSE 3001
HEALTHCHECK --interval=15s --timeout=3s --start-period=10s --retries=3 \
  CMD wget -q -O /dev/null "http://127.0.0.1:${MCP_PORT:-3001}/health" || exit 1
CMD ["node", "dist/server.js"]
