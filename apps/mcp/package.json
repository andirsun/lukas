{
  "name": "@lukas/mcp",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "dev": "tsx watch --env-file-if-exists=../../.env src/server.ts",
    "start": "tsx --env-file-if-exists=../../.env src/server.ts",
    "api:types": "pnpm --filter @lukas/web api:types --file --types \"$PWD/src/api/schema.d.ts\"",
    "build": "esbuild src/server.ts --bundle --platform=node --target=node22 --format=esm --outdir=dist --entry-names=[name] --legal-comments=none --banner:js=\"import { createRequire as __createRequire } from 'node:module'; const require = __createRequire(import.meta.url);\"",
    "start:prod": "node dist/server.js"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.5",
    "@lukas/ai-assistant-tools": "workspace:*",
    "@lukas/core": "workspace:*",
    "@modelcontextprotocol/server": "2.3.1",
    "hono": "^4.13.13",
    "jose": "^6.2.12",
    "openapi-fetch": "^0.17.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.3.1",
    "esbuild": "0.28.2"
  }
}
