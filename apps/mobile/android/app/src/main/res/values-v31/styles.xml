<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 12 and later draw their own splash (the app icon on a background) and ignore the
         launch drawable: both in the night background as well. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
        <item name="android:windowSplashScreenBackground">@color/lukitas_night_bg</item>
        <item name="android:windowSplashScreenIconBackgroundColor">@color/lukitas_night_bg</item>
    </style>
    <style name="NormalTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@color/lukitas_night_bg</item>
    </style>
</resources>
