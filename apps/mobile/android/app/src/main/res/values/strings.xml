<?xml version="1.0" encoding="utf-8"?>
<!-- The home-screen widget and the Quick Settings tile (spec section 7.1). Spanish is the default;
     values-en has English. The app's own words are in lib/l10n (ARB). -->
<resources>
    <!-- The figure's label: with budgets, money left or overspent; without, what was spent. -->
    <string name="widget_remaining">Te quedan</string>
    <string name="widget_over">Te pasaste</string>
    <string name="widget_spent">Gastado este mes</string>
    <!-- The same for an earlier month (the figures are from before today's month). -->
    <string name="widget_remaining_past">Te quedaron en %1$s</string>
    <string name="widget_over_past">Te pasaste en %1$s</string>
    <string name="widget_spent_past">Gastado en %1$s</string>
    <string name="widget_signed_out">Abre Lukitas para empezar</string>
    <!-- Under the figure when it could not be refreshed for a while (offline). -->
    <string name="widget_stale">hace un rato</string>
    <!-- Settings' "Ocultar el monto en el widget". -->
    <string name="widget_hidden" translatable="false">••••</string>
    <!-- The buttons, read aloud: the same words as the ＋ and 🎤 on home. -->
    <string name="widget_add">Agregar gasto</string>
    <string name="widget_capture">Decir o escribir un gasto</string>
    <string name="widget_lukitas">Lukitas</string>
    <!-- The widget picker. -->
    <string name="widget_small_description">Lo que te queda este mes, y ＋ para anotar un gasto.</string>
    <string name="widget_medium_description">Lukitas, lo que te queda este mes, ＋ y 🎤 para anotar.</string>
    <!-- The Quick Settings tile: opens quick capture, listening. -->
    <string name="tile_capture">Decir un gasto</string>
    <!-- With the amount hidden: a neutral label (nothing about how the month goes), and what
         TalkBack reads in place of the dots. -->
    <string name="widget_hidden_label">Este mes</string>
    <string name="widget_amount_hidden">Monto oculto</string>
    <!-- The progress bar, read aloud. -->
    <string name="widget_progress">%1$d %% del presupuesto gastado</string>
</resources>
