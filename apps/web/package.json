{
  "name": "@lukas/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "react-router dev",
    "build": "react-router build",
    "typecheck": "react-router typegen && tsc --noEmit",
    "tokens": "tsx scripts/gen-tokens.ts",
    "sounds": "tsx scripts/gen-feedback-sounds.ts",
    "og": "tsx scripts/og/render.ts",
    "api:types": "tsx scripts/gen-api.ts",
    "storybook": "storybook dev --port 6006",
    "parity:fixtures": "tsx scripts/parity-fixtures.ts",
    "parity:shots": "tsx scripts/parity-shots.ts",
    "parity:insights-geometry": "tsx scripts/insights-geometry.ts",
    "test": "vitest run",
    "e2e": "playwright test",
    "build:landing": "tsx scripts/build-landing.ts",
    "e2e:landing": "react-router build && playwright test -c playwright.built.config.ts",
    "e2e:landing-only": "VITE_APP_URL= VITE_SITE_URL=https://landing-only.example.test tsx scripts/build-landing.ts && E2E_LANDING_ONLY=true VITE_APP_URL= VITE_SITE_URL=https://landing-only.example.test playwright test -c playwright.built.config.ts",
    "e2e:landing-only-app": "VITE_APP_URL=https://app.example.test VITE_SITE_URL=https://landing-only.example.test tsx scripts/build-landing.ts && E2E_LANDING_ONLY=app VITE_APP_URL=https://app.example.test VITE_SITE_URL=https://landing-only.example.test playwright test -c playwright.built.config.ts"
  },
  "dependencies": {
    "@better-auth/passkey": "^1.7.11",
    "@fontsource/fredoka": "^5.3.0",
    "@fontsource/nunito": "^5.3.0",
    "@lukas/core": "workspace:*",
    "@react-router/node": "^8.5.0",
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.2",
    "@tanstack/react-query": "^5.104.5",
    "better-auth": "^1.7.11",
    "isbot": "^5",
    "motion": "^14.4.0",
    "openapi-fetch": "^0.17.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.0",
    "recharts": "3.10.1",
    "three": "^0.186.1",
    "use-intl": "^4.14.9"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "@react-router/dev": "^8.5.0",
    "@storybook/addon-a11y": "^10.6.3",
    "@storybook/addon-vitest": "^10.6.3",
    "@storybook/react-vite": "^10.6.3",
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/browser": "^5.0.5",
    "@vitest/browser-playwright": "^5.0.5",
    "openapi-typescript": "^7.13.0",
    "playwright": "^1.64.1",
    "storybook": "^10.6.3",
    "tailwindcss": "^4.3.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  }
}
