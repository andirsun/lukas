# Local development defaults. Copy to .env.
# The API connects as lukas_app (row-level security applies); migrations run as the admin role.
DATABASE_URL=postgres://lukas_app:lukas_app@localhost:5432/lukas
DATABASE_ADMIN_URL=postgres://lukas:lukas@localhost:5432/lukas
BETTER_AUTH_SECRET=dev-only-secret-change-me-in-production-0123456789
API_URL=http://localhost:3000
WEB_URL=http://localhost:5173
MAIL_FROM=Lukas <hola@lukas.local>
SMTP_URL=smtp://localhost:1025
# RESEND_API_KEY=
PORT=3000
NODE_ENV=development
# Client IP for rate limiting. Behind your own proxy, list its ranges in TRUSTED_PROXIES; on a
# platform that sets a dedicated header (fly-client-ip, cf-connecting-ip…) set CLIENT_IP_HEADER.
# Production refuses to start with a bare, spoofable X-Forwarded-For.
CLIENT_IP_HEADER=x-forwarded-for
TRUSTED_PROXIES=
