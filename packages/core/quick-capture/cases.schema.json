{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lukitas.app/schemas/quick-capture-cases.schema.json",
  "title": "Quick-capture parser cases",
  "description": "Shared test cases for the on-device sentence parser (spec section 5). Every parser (Dart, TypeScript) must produce `expected` for each case.",
  "type": "array",
  "minItems": 1,
  "items": { "$ref": "#/$defs/case" },
  "$defs": {
    "isoDate": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "kind": { "enum": ["expense", "income"] },
    "category": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "kind"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "kind": { "$ref": "#/$defs/kind" }
      }
    },
    "usual": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "categoryId"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "categoryId": { "type": "string", "minLength": 1 }
      }
    },
    "draft": {
      "type": "object",
      "additionalProperties": false,
      "required": ["amount", "kind", "name", "categoryId", "date"],
      "properties": {
        "amount": { "type": "integer", "minimum": 1 },
        "kind": { "$ref": "#/$defs/kind" },
        "name": { "type": "string" },
        "categoryId": { "type": ["string", "null"], "minLength": 1 },
        "date": { "$ref": "#/$defs/isoDate" }
      }
    },
    "case": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "input",
        "locale",
        "currency",
        "today",
        "timeZone",
        "categories",
        "usual",
        "expected"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^(spike|real|amount|focus|date|kind|split|category|unread)(-[a-z0-9]+)+$"
        },
        "input": { "type": "string", "minLength": 1 },
        "locale": { "enum": ["es", "en", "it", "pt"] },
        "currency": { "enum": ["COP", "EUR", "USD"] },
        "today": { "$ref": "#/$defs/isoDate" },
        "timeZone": { "type": "string", "minLength": 1 },
        "categories": { "type": "array", "items": { "$ref": "#/$defs/category" } },
        "usual": { "type": "array", "items": { "$ref": "#/$defs/usual" } },
        "expected": {
          "type": "object",
          "additionalProperties": false,
          "required": ["drafts", "unread"],
          "properties": {
            "drafts": { "type": "array", "items": { "$ref": "#/$defs/draft" } },
            "unread": { "type": "array", "items": { "type": "string", "minLength": 1 } }
          }
        }
      }
    }
  }
}
